rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jonnyghosh3@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users: Allow read for checking referral codes & emails; allow update for owner, admin, or referral rewards
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Tasks: Readable by everyone; editable by admin
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Referrals
    match /referrals/{referralId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
